{
  "name": "web-plane",
  "version": "0.3.4",
  "description": "The web control plane for AI agents. Real Chrome, zero flash, Cloudflare-proof.",
  "type": "module",
  "bin": {
    "web-plane": "./bin/web-plane.js"
  },
  "keywords": [
    "browser",
    "automation",
    "ai",
    "agent",
    "chrome",
    "cloudflare",
    "playwright",
    "cui",
    "web"
  ],
  "license": "MIT",
  "scripts": {
    "test": "npm run check && npm run test:unit",
    "check": "node scripts/check-syntax.mjs",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:doctor": "node --test \"tests/doctor/*.test.js\"",
    "test:integration": "node scripts/run-integration-files.mjs",
    "test:mutation": "node tests/mutation/run.js"
  },
  "dependencies": {
    "agent-browser": "0.34.0"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "bin/",
    "lib/",
    "native/",
    "patches/",
    "runtime/",
    "README.md",
    "LICENSE"
  ]
}
